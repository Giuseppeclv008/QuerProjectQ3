@startuml C4_Component
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()
title Component Diagram — C++ Core Library (mas_core + mas_transport)

Container_Boundary(domain, "mas_core / domain layer") {

    Component(csv_reader, "CsvRawReader", "C++ class", "Streams and parses raw CSV rows")

    Component(extractor, "CapEventExtractor", "C++ class", "Per-head dedup; emits cap events")

    Component(pipeline, "clean_file()", "Free function", "Runs reader to extractor to store")

    Component(cap_event, "CapEvent / RawRow", "C++ structs", "Domain value types (36 heads)")

    Component(extractor_flat, "extract_flat() /\nload_columns() / RawColumns", "Free functions", "Stateless form of the same transform")
}

Container_Boundary(store, "mas_core / store layer") {

    Component(event_store_if, "IEventStore", "Abstract interface", "Persistence seam: write(events)")

    Component(csv_store, "CsvEventStore", "C++ class : IEventStore", "Appends events to a CSV file")

    Component(duckdb_store, "DuckDbEventStore", "C++ class : IEventStore", "DuckDB store, deduplicated on insert")

    Component(parquet_store, "ParquetEventStore", "C++ class : IEventStore", "Publishes one Parquet file per day-file")

    Component(parquet_export, "export_store_to_parquet()", "Free function", "Exports a store to Parquet")

    Component(atomic_publish, "publish_atomically() /\ntemp_sibling_of()", "Free functions", "Write to temp, then rename")

    Component(beating_store, "BeatingStore", "C++ class : IEventStore", "Decorator that throttles heartbeats")

    Component(sql_util, "sql_quote() / DuckDbExec", "Free functions", "SQL quoting and exec-or-throw helpers")
}

Container_Boundary(agent, "mas_core / agent layer") {

    Component(message, "Message / WorkItem / WorkResult /\nWorkClaim / Goodbye / Heartbeat", "C++ structs + codec", "Wire protocol and its codec")

    Component(worker, "CleaningWorker", "C++ class", "Claims a file, cleans it, reports back")

    Component(coordinator, "run_coordinator()", "Free function", "Dispatches work, detects dead workers")
}

Container_Boundary(util, "mas_core / util layer (header-only)") {

    Component(metrics, "ProcMetrics / read_metrics()", "Free functions", "Self-reported wall, CPU and peak RSS")

    Component(engine_sel, "parse_engine() / resolve_engine()", "Free functions", "CPU/CUDA selection, no silent fallback")

    Component(cli_args, "unconsumed_flag()", "Free function", "Rejects unrecognised flags")
}

Container_Boundary(cuda_lib, "mas_cuda_cleaner (MAS_ENABLE_CUDA)") {

    Component(cuda_clean, "cuda_clean_file() /\nCudaStageTimes", "CUDA host + kernels", "GPU form of the cleaning pipeline")
}

Container_Boundary(transport_lib, "mas_transport library") {

    Component(transport_if, "IMessageSource / IMessageSink", "Abstract interfaces", "Transport seam: recv and send")

    Component(zmq_push, "ZmqPushSink", "C++ class : IMessageSink", "ZeroMQ PUSH socket adapter")

    Component(zmq_pull, "ZmqPullSource", "C++ class : IMessageSource", "ZeroMQ PULL socket adapter")
}

Rel(pipeline, csv_reader, "Reads rows from")
Rel(pipeline, extractor, "Feeds rows to, collects CapEvents")
Rel(pipeline, event_store_if, "Writes batches to")
Rel(csv_store, event_store_if, "Implements")
Rel(duckdb_store, event_store_if, "Implements")
Rel(extractor, cap_event, "Produces CapEvent, consumes RawRow")
Rel(csv_reader, cap_event, "Produces RawRow")
Rel(worker, transport_if, "Receives WorkItems / sends Results+HB via")
Rel(worker, event_store_if, "Writes events to injected store")
Rel(worker, pipeline, "Calls clean_file() via injected CleanFn")
Rel(coordinator, transport_if, "Sends WorkItems / receives Results+HB via")
Rel(coordinator, message, "Encodes/decodes messages")
Rel(worker, message, "Encodes/decodes messages")
Rel(zmq_push, transport_if, "Implements IMessageSink")
Rel(zmq_pull, transport_if, "Implements IMessageSource")
Rel(parquet_store, event_store_if, "Implements")
Rel(parquet_store, atomic_publish, "Publishes through")
Rel(parquet_export, atomic_publish, "Publishes through")
Rel(beating_store, event_store_if, "Decorates")
Rel(duckdb_store, sql_util, "Escapes/executes via")
Rel(cuda_clean, extractor_flat, "Differential-tested against")

@enduml
