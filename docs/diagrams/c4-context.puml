@startuml C4_Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()
title System Context Diagram — IIoT Data Refinement MAS

Person(operator, "Operator / Data Engineer", "Starts runs, inspects results")

System(mas, "IIoT Data Refinement MAS", "Turns raw PLC telemetry into cap events in DuckDB")

System_Ext(plc, "AROL Capping Machine PLC", "Logs 36 heads at 1 Hz into CSV day-files")
System_Ext(fs, "File System", "Holds raw CSVs and output databases")
System(oracle, "Python Validation Oracle", "Cross-checks the C++ output")

Rel(plc, fs, "Uploads raw CSV day-files")
Rel(operator, mas, "Provides raw day-file paths, starts coordinator/workers or monolith")
Rel(mas, fs, "Reads raw CSVs, writes DuckDB/CSV/Parquet outputs")
Rel(operator, oracle, "Runs validation to cross-check C++ output")
Rel(oracle, fs, "Reads raw CSVs and C++ output CSVs")

@enduml
